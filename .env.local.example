# ==========================================
# PAYPAL CONFIGURATION
# ==========================================
# Récupère ces valeurs depuis https://developer.paypal.com/dashboard

# ID client PayPal (public - peut être exposé au frontend)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE

# Secret PayPal (PRIVÉ - ne jamais exposer)
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE

# ID client PayPal (dans le backend)
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE

# URL de base PayPal
PAYPAL_BASE_URL=https://api-m.paypal.com
# Pour les tests: https://api-m.sandbox.paypal.com

# ==========================================
# FRONTEND URL (pour PayPal callbacks)
# ==========================================
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# Production: https://williamsmobil-frontend.vercel.app

# ==========================================
# EMAIL CONFIGURATION (Nodemailer)
# ==========================================
# Utilise Gmail avec un mot de passe d'application
# Guide: https://support.google.com/accounts/answer/185833

SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ==========================================
# BACKEND URL (IMPORTANT: Must use NEXT_PUBLIC_ prefix)
# ==========================================
# In Next.js, only variables prefixed with NEXT_PUBLIC_ are accessible
# at runtime in API routes and client-side code.
#
# Development: defaults to http://localhost:5001 if not set
# Production (Vercel): set this to your Railway backend URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001
# Production example: https://williamsmobil-backend.railway.app

# ==========================================
# AUTRES
# ==========================================
NODE_ENV=development

